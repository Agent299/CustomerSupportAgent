# Copy to .env and fill in. .env is git-ignored.

# --- App ---
APP_ENV=local                 # local | ci | prod
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- LLM (OpenAI) ---
OPENAI_API_KEY=
# Model per task tier; chosen by per-task evals (see docs/PLAN.md §5). Leave blank until Phase 2.
MODEL_EASY=
MODEL_HARD=
MODEL_JUDGE=
EMBEDDING_PROVIDER=openai         # openai | hash (offline, deterministic; tests/demos)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
DAILY_SPEND_CAP_USD=2.00
USER_DAILY_MESSAGE_QUOTA=30

# --- Datastores (defaults match infra/docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://support:support@localhost:5432/support
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=kb_chunks
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=localdevpassword

# --- Ingest webhook (POST /api/ingest/collect, header X-Ingest-Token). Empty = disabled. ---
INGEST_WEBHOOK_TOKEN=

# --- Object storage (S3 API; Cloudflare R2 in prod) ---
S3_ENDPOINT_URL=
S3_BUCKET=kb-snapshots
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Auth (Phase 4) ---
JWT_SECRET=change-me
RESEND_API_KEY=
EMAIL_FROM=
TURNSTILE_SECRET_KEY=
AGENT_EMAIL_ALLOWLIST=
