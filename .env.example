# Local development. Copy to .env and fill in (git-ignored).

# --- App ---
APP_ENV=local                 # local | ci | prod
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- LLM (OpenAI) ---
OPENAI_API_KEY=
# Model per task tier, chosen by per-task evals (docs/PLAN.md §5, docs/evals/answers-baseline-v0.md).
MODEL_EASY=gpt-4.1-nano           # search plan: standalone query + expansion terms (fastest)
MODEL_HARD=gpt-6-luna             # answer synthesis
MODEL_JUDGE=gpt-6-astra           # eval judge only (make eval-answers)
# reasoning_effort for reasoning models; blank = model default. "low" keeps TTFT p90 < 3 s.
MODEL_EASY_REASONING=             # gpt-4.1-nano is not a reasoning model: leave blank
MODEL_HARD_REASONING=low
MODEL_JUDGE_REASONING=
EMBEDDING_PROVIDER=openai         # openai | hash (offline, deterministic; tests/demos)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
QUERY_EXPANSION=true              # search terms from MODEL_EASY on every question
DAILY_SPEND_CAP_USD=2.00
USER_DAILY_MESSAGE_QUOTA=30

# --- Datastores (defaults match infra/docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://support:support@localhost:5432/support
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=kb_chunks
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=localdevpassword

# --- Ingest webhook (POST /api/ingest/collect, header X-Ingest-Token). Empty = disabled. ---
INGEST_WEBHOOK_TOKEN=

# --- Auth (Phase 4) ---
JWT_SECRET=change-me
RESEND_API_KEY=
EMAIL_FROM=
TURNSTILE_SECRET_KEY=
AGENT_EMAIL_ALLOWLIST=
