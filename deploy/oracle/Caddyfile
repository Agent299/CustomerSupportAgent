# Single origin for the UI and the API (docs/PLAN.md §9).
# SITE_ADDRESS: a domain (support.example.com), <public-ip>.sslip.io (no domain needed),
# or :80 for plain HTTP. Caddy obtains and renews HTTPS certificates automatically.
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@backend path /api/* /healthz /readyz /docs /docs/* /openapi.json
	handle @backend {
		# SSE answer streaming (Phase 2) needs unbuffered responses.
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle {
		root * /srv/www
		try_files {path} {path}/index.html {path}.html
		file_server
	}

	handle_errors 404 {
		root * /srv/www
		rewrite * /404.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
