# Production settings for the Oracle VM. Copy to deploy/oracle/.env (git-ignored, chmod 600).

# Public address Caddy serves (HTTPS is automatic for domain names):
#   SITE_ADDRESS=support.example.com        # your domain, A record → VM public IP
#   SITE_ADDRESS=203-0-113-10.sslip.io      # no domain: <public-ip-with-dashes>.sslip.io
SITE_ADDRESS=

# Strong random values, e.g. `openssl rand -base64 32`
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
INGEST_WEBHOOK_TOKEN=

OPENAI_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

LOG_LEVEL=INFO
